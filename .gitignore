node_modules/
/.pnp
.pnp.*

# next.js (the app lives in frontend/)
/frontend/.next/
/frontend/out/
next-env.d.ts

# production
/frontend/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (secrets)
.env
.env*.local
.env.production

# typescript
*.tsbuildinfo

