# dependencies
node_modules/
/.pnp
.pnp.*

# next.js (the app lives in frontend/)
/frontend/.next/
/frontend/out/
next-env.d.ts

# production
/frontend/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (secrets)
.env
.env*.local
.env.production

# typescript
*.tsbuildinfo

# drizzle
/frontend/drizzle/meta

# vercel
.vercel

# terraform / opentofu
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# never commit real var files (they hold secrets); keep the example
*.tfvars
*.tfvars.json
!*.tfvars.example

# service account keys — tf-admin-sa.sh writes its key to ~/.config/gcloud, so
# this only catches a KEY_FILE override that pointed somewhere inside the repo
*-tf-admin.json
*-sa-key.json

# stray local cloud-sql-proxy binary (use the brew/PATH one instead)
/cloud-sql-proxy
# admin infra lock (tofu-generated, not tracked)
/infra/admin/.terraform.lock.hcl
# local-only backend block written by scripts/backend-local.sh. Committing it
# would override the backend the Harness IaCM workspace injects during pipeline
# runs, splitting the state — see the note in infra/admin/versions.tf.
/infra/admin/backend_local.tf
