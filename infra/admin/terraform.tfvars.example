# Copy to terraform.tfvars and fill in. Do NOT commit the real file.

# Control plane — see README.md#control-plane
admin_project_id    = "my-admin-project"
region              = "us-central1"
# workshop_region     = "us-west1"
# gke_zones           = ""                      # empty = the runner's list for that region
workshops_folder_id = "123456789012"          # numeric folder ID
billing_account_id  = "XXXXXX-XXXXXX-XXXXXX"
tfstate_bucket      = "my-admin-project-ws-tfstate"

# Google Workspace — see README.md#google-workspace
workspace_domain      = "example.com"
workspace_admin_email = "admin@example.com"
# workspace_parent_ou = "/Workshops"

# Harness — see README.md#harness
harness_account_id = "replace-me"
harness_api_key    = "pat.xxxxx"
# harness_base_url = "https://app.harness.io"

# Azure — see README.md#azure
azure_subscription_id = "00000000-0000-0000-0000-000000000000"
azure_tenant_id       = "00000000-0000-0000-0000-000000000000"
azure_client_id       = "00000000-0000-0000-0000-000000000000"
azure_client_secret   = "replace-me"
azure_location        = "eastus"

# AWS — see README.md#aws
aws_access_key_id        = "AKIAxxxxxxxxxxxxxxxx"
aws_secret_access_key    = "replace-me"
aws_region               = "us-east-1"
aws_parent_ou_id         = ""                       # empty = org root
aws_account_email_domain = ""                       # empty = workspace_domain

# Google OAuth — see README.md#google-oauth
google_oauth_client_id     = "xxxx.apps.googleusercontent.com"
google_oauth_client_secret = "xxxx"
# app_url = "https://workshop-orchestrator-xxxxx-uc.a.run.app"

# Site roles — see README.md#site-roles
site_admin_emails = ["you@example.com"]

# Who may sign in — see README.md#restricting-sign-in
# Normally managed in the app (Admin settings). Set here only to bootstrap it,
# or to get back in if that list is ever wrong; these are always in force.
# allowed_email_domains = ["example.com"]

# Custom domains — see README.md#custom-domains
# custom_domains = ["example.com", "www.example.com"]

# Tuning — see README.md#tuning
# db_tier            = "db-custom-1-3840"
# reaper_schedule    = "*/5 * * * *"
# scheduler_schedule = "*/5 * * * *"

# Container images — see README.md#container-images
# app_image    = "us-central1-docker.pkg.dev/my-admin-project/workshop-orchestrator/app:latest"
# runner_image = "us-central1-docker.pkg.dev/my-admin-project/workshop-orchestrator/runner:latest"

# Continuous deployment — see README.md#continuous-deployment
# enable_cicd                = true
# github_owner               = "my-github-user"
# github_repo                = "wsorchestrator"      # repo name only, no owner
# github_app_installation_id = "12345678"
# github_pat_secret_id       = ""                    # default
