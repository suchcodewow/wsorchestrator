# Copy to terraform.tfvars and fill in. Do NOT commit the real file.

admin_project_id    = "my-admin-project"
region              = "us-central1"
workshops_folder_id = "123456789012"          # numeric folder ID
billing_account_id  = "XXXXXX-XXXXXX-XXXXXX"
tfstate_bucket      = "my-admin-project-ws-tfstate"

# Google Workspace — attendee accounts are created here. runner-sa needs
# domain-wide delegation for admin.directory.orgunit + admin.directory.user,
# and impersonates workspace_admin_email (a super-admin).
workspace_domain      = "example.com"
workspace_admin_email = "admin@example.com"
# workspace_parent_ou = "/Workshops"

# Harness — each workshop becomes an org here, with a project per attendee.
# The API key needs org/project create and user invite rights.
harness_account_id = "replace-me"
harness_api_key    = "pat.xxxxx"
# harness_base_url = "https://app.harness.io"

# db_tier         = "db-custom-1-3840"   # smallest valid Postgres tier
# reaper_schedule = "*/5 * * * *"

# Google OAuth 2.0 client (APIs & Services -> Credentials in the admin project).
# Authorized redirect URI: <app_url>/api/auth/callback/google
google_oauth_client_id     = "xxxx.apps.googleusercontent.com"
google_oauth_client_secret = "xxxx"

# After the first apply, set this to the app_url output and re-apply so
# Auth.js pins AUTH_URL (Google rejects a guessed 0.0.0.0 redirect_uri):
# app_url = "https://workshop-orchestrator-xxxxx-uc.a.run.app"

# After you build+push real images (step #3), set these and re-apply:
# app_image    = "us-central1-docker.pkg.dev/my-admin-project/workshop-orchestrator/app:latest"
# runner_image = "us-central1-docker.pkg.dev/my-admin-project/workshop-orchestrator/runner:latest"
