# The build context is this directory, so infra/ and runner/ are already
# outside it and no longer need excluding.
node_modules
.next
.git
npm-debug.log
.env
.env*.local
# Imports ../../runner, which is outside this context, so `next build`'s
# typecheck cannot resolve it. It is a local-only tool; `npm run verify` checks it.
scripts/import-production.ts
