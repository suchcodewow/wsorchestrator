{
  "name": "workshop-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/migrate-local.mjs",
    "dev": "NODE_USE_SYSTEM_CA=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test test/unit/*.test.ts",
    "test:watch": "tsx --conditions=react-server --test --watch test/unit/*.test.ts",
    "test:db": "tsx --conditions=react-server --test --test-concurrency=1 test/db/*.test.ts",
    "test:e2e": "tsx --conditions=react-server --test --test-concurrency=1 test/e2e/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:import-production": "tsx --conditions=react-server --env-file=.env scripts/import-production.ts",
    "db:up": "docker compose -f ../docker-compose.yml up -d",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "dev:setup": "docker compose -f ../docker-compose.yml up -d --wait && node scripts/dev-setup.mjs",
    "db:worktree": "node scripts/worktree-db.mjs create",
    "db:worktree:drop": "node scripts/worktree-db.mjs drop"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.3",
    "framer-motion": "^12.43.0",
    "github-slugger": "^2.0.0",
    "google-auth-library": "^9.15.0",
    "gsap": "^3.15.0",
    "hast-util-to-string": "^3.0.1",
    "inter-ui": "^4.1.1",
    "lucide-react": "^0.469.0",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.25",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^3.23.0",
    "tailwind-merge": "^2.6.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.1.4",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true
  }
}
