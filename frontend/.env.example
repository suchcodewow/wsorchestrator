# --- Database (Cloud SQL for Postgres) ---
# Local dev: point at a local/proxied Postgres.
# Cloud Run: use the Cloud SQL connector socket, e.g.
#   postgresql://USER:PASS@localhost/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workshops"

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# In production set to the deployed URL, e.g. https://app.example.com
AUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# Create OAuth 2.0 credentials in the admin GCP project's API & Services console.
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID="replace-me.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="replace-me"

# --- Who may sign in ---
# Normally set from the app: Admin settings -> Sign-in domains, which is stored
# in the database. This variable is the bootstrap and the way back in — its
# domains are unioned with that list and are always in force, and the settings
# page shows them as locked rows it cannot edit.
#
# Comma separated (e.g. "example.com, partner.com"). Empty here *and* an empty
# table means no restriction: anyone with a Google account signs in, as an
# operator. Addresses in SITE_ADMIN_EMAILS are always allowed whatever their
# domain, so neither list can lock the site's administrators out.
#
# Attendee pages (/attend/...) are public and unaffected: attendees open a link
# and never sign in here.
AUTH_ALLOWED_EMAIL_DOMAINS=""

# --- Site roles ---
# Everyone who signs in is an "operator" (their own events). "manager" adds
# every user's events plus deleting any of them; "administrator" adds the users
# page, where roles are handed out.
#
# Roles are granted by an administrator, so the first one has to come from
# here: any email listed is made an administrator when it signs in. Comma
# separated. Leave empty once the site has an administrator who can promote the
# rest.
SITE_ADMIN_EMAILS=""

# --- GCP (control plane) ---
# Admin project that owns state bucket, Cloud SQL, service accounts.
GCP_ADMIN_PROJECT_ID="replace-me"
# Folder under which ephemeral workshop projects are created.
GCP_WORKSHOPS_FOLDER_ID="replace-me"
# Billing account new workshop projects are linked to.
GCP_BILLING_ACCOUNT_ID="XXXXXX-XXXXXX-XXXXXX"
# GCS bucket for Terraform state (in the admin project).
GCP_TFSTATE_BUCKET="replace-me-tfstate"
# Shared long-lived project a no-cloud run grants attendees. Set by Terraform
# in the deployed app; the Projects audit treats it (and the admin project) as
# expected infra rather than an orphan.
GCP_SANDBOX_PROJECT_ID="replace-me-sandbox"

# Cloud SQL instance the backups page lists and restores. Set by Terraform in
# the deployed app; leave unset locally, where the page says so rather than
# offering to restore a database that isn't there.
CLOUD_SQL_INSTANCE="workshops-db"

# --- Google Workspace (attendee accounts) ---
# The runner creates one organizational unit per workshop and N accounts in it,
# via the Admin SDK Directory API. This requires runner-sa to have domain-wide
# delegation for the admin.directory.orgunit + admin.directory.user scopes, and
# a super-admin to impersonate (the API rejects service accounts acting as
# themselves).
GOOGLE_WORKSPACE_DOMAIN="example.com"
GOOGLE_WORKSPACE_ADMIN_EMAIL="admin@example.com"
# Defaults to "my_customer" (the impersonated admin's own customer).
GOOGLE_WORKSPACE_CUSTOMER_ID=""
# Parent OU the per-workshop org units are created under.
GOOGLE_WORKSPACE_PARENT_OU="/"

# --- Harness ---
# Every workshop gets a Harness organization named after it, containing one
# project per attendee. The key needs rights to create organizations and
# projects and to invite users; it is stored in Secret Manager when deployed.
HARNESS_ACCOUNT_ID="replace-me"
HARNESS_API_KEY="pat.xxxxx"
# Change for a non-SaaS or non-prod cluster. Also where My settings → My tokens
# validates a token somebody pastes, so a token for another cluster is refused.
HARNESS_BASE_URL="https://app.harness.io"
# Encryption key for the Harness tokens users save under My settings. Those have
# to be usable again, so they are encrypted rather than hashed. Unset, the key is
# derived from AUTH_SECRET, which is why this needs no configuration to work —
# set it when the two should rotate independently, since changing AUTH_SECRET
# otherwise makes every saved token undecryptable (the tab says so, and the fix
# is pasting them again). Any high-entropy string; 32+ bytes.
# HARNESS_TOKEN_ENC_KEY="replace-me"
# Built-in role / resource-group identifiers, and their display names. Override
# only if this account uses different ones — Harness does not publish the
# defaults. The names are sent with the invite alongside the identifiers: the
# identifier grants the access, the name is what Harness composes its
# notification email from, and omitting it has been seen to fail as a 500.
# HARNESS_PROJECT_ADMIN_ROLE="_project_admin"
# HARNESS_PROJECT_ADMIN_ROLE_NAME="Project Admin"
# HARNESS_PROJECT_ADMIN_RESOURCE_GROUP="_all_project_level_resources"
# HARNESS_PROJECT_ADMIN_RESOURCE_GROUP_NAME="All Project Level Resources"
# HARNESS_ORG_VIEWER_ROLE="_organization_viewer"
# HARNESS_ORG_VIEWER_ROLE_NAME="Organization Viewer"
# HARNESS_ORG_VIEWER_RESOURCE_GROUP="_all_organization_level_resources"
# HARNESS_ORG_VIEWER_RESOURCE_GROUP_NAME="All Organization Level Resources"

# --- Local dev only ---
# The runner shells out to `tofu` (OpenTofu), matching the provider registry
# the committed .terraform.lock.hcl files pin. Override only if you have
# Terraform instead.
# TF_BIN="terraform"
