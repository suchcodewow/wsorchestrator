# --- Database (Cloud SQL for Postgres) ---
# Local dev: point at a local/proxied Postgres.
# Cloud Run: use the Cloud SQL connector socket, e.g.
#   postgresql://USER:PASS@localhost/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workshops"

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# In production set to the deployed URL, e.g. https://app.example.com
AUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# Create OAuth 2.0 credentials in the admin GCP project's API & Services console.
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID="replace-me.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="replace-me"

# --- GCP (control plane) ---
# Admin project that owns state bucket, Cloud SQL, service accounts.
GCP_ADMIN_PROJECT_ID="replace-me"
# Folder under which ephemeral workshop projects are created.
GCP_WORKSHOPS_FOLDER_ID="replace-me"
# Billing account new workshop projects are linked to.
GCP_BILLING_ACCOUNT_ID="XXXXXX-XXXXXX-XXXXXX"
# GCS bucket for Terraform state (in the admin project).
GCP_TFSTATE_BUCKET="replace-me-tfstate"
